{% for hk in hkb.hks %}
[#text(size: 8.5pt)[{{ hk.id | typ }}]], [{{ hk.name | typ }}], [#text(size: 8.5pt)[{% if hk.pw == "P" %}#square(size: 3pt, fill: accent)#h(1.5mm)#text(weight: "bold", fill: accent)[Pflicht]{% elif hk.pw == "W" %}#square(size: 3pt, fill: faint)#h(1.5mm)#text(fill: muted)[Wahl]{% endif %}]],
