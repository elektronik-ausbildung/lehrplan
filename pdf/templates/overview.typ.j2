  table.header(
    [#text(weight: "bold", size: 10pt, fill: white)[ID]],
    [#text(weight: "bold", size: 10pt, fill: white)[Bezeichnung]],
    [#text(weight: "bold", size: 10pt, fill: white)[Typ]],
  ),
